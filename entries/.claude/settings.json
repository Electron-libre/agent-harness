{
  "permissions": {
    "allow": [
      "Bash(cardinal run *)"
    ],
    "deny": [
      "Bash(just waive-review)",
      "Bash(just waive-review *)",
      "Edit(//**/claude-review-waived)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run review-gate check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run review-gate record"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run format-rust"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cardinal run clippy-gate",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "cardinal run language-hint",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
